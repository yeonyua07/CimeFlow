# UI server
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Relay server
RELAY_PORT=3001
INSTANCE_ID=
MAX_SESSIONS=1000
MAX_CHANNEL_HUBS=300
MAX_CLIENTS_PER_CHANNEL=100
MAX_WS_PER_IP=50
RATE_LIMIT_WINDOW_MS=60000
HTTP_RATE_LIMIT_MAX=240
CHANNEL_LOOKUP_RATE_LIMIT_MAX=60
CHANNEL_IDLE_TTL_MS=30000
BATCH_INTERVAL_MS=100
# 프로덕션에서는 반드시 실제 도메인으로 변경하세요. 예: https://example.com
# CORS_ORIGIN=* 상태로 프로덕션 배포 시 모든 오리진에서 접속이 허용됩니다.
CORS_ORIGIN=*
TRUST_PROXY=false
REDIS_CONNECT_TIMEOUT_MS=1500
#프로덕션에서는 반드시 안전한 토큰을 설정하세요 (예: openssl rand -hex 32).
# 비워두면 /metrics 엔드포인트가 인증 없이 공개됩니다.
METRICS_TOKEN=
# 프로덕션에서는 반드시 안전한 토큰을 설정하세요 (예: openssl rand -hex 32).
# 비워두면 /api/drain 엔드포인트가 비활성화됩니다.
ADMIN_TOKEN=
DRAIN_TIMEOUT_MS=30000
LOG_IP_MODE=hash
# IP_HASH_SALT를 고정값으로 설정하지 않으면 프로세스 재시작마다 같은 IP가 다른 해시로 기록됩니다.
# 로그 추적이 필요하다면 고정 salt를 설정하세요 (예: openssl rand -hex 32).
IP_HASH_SALT=

# Redis (선택 사항 — 다중 인스턴스 분산 환경에서만 필요합니다)
# 단일 인스턴스 배포라면 이 줄을 주석 처리된 상태로 두세요.
# REDIS_URL=redis://localhost:6379

# 로드테스트 전용. 실제 ci.me 연결 없이 더미 메시지를 생성합니다.
# 프로덕션에서는 절대 활성화하지 마세요.
MOCK_CIME_UPSTREAM=false
MOCK_MESSAGE_INTERVAL_MS=100

# 브라우저가 Relay 서버에 접속할 URL입니다.
# 비워두면 현재 호스트의 3001 포트로 자동 연결됩니다.
# NEXT_PUBLIC_CIME_RELAY_HTTP_URL=http://localhost:3001
# NEXT_PUBLIC_CIME_RELAY_WS_URL=ws://localhost:3001
